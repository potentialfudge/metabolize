SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key-here"

[auth]
redirect_uri="http://your-project-ref/oauth2callback"
cookie_secret="your-cookie-secret-here"
expose_tokens = ["id"]

[auth.google]
client_id="your-project-ref.apps.googleusercontent.com"
client_secret="your-client-secret-here"
server_metadata_url="https://accounts.google.com/.well-known/openid-configuration"

[auth.auth0]
domain="your-project-ref.auth0.com"
client_id=""your-client-id-here""
client_secret="your-client-secret-here"
server_metadata_url="https://your-project-ref.auth0.com/.well-known/openid-configuration"